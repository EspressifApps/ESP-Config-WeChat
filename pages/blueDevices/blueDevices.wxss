/* pages/blueDevices/blueDevices.wxss */
.filter-bar {
  width: 100%;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background: #fff;
  border-bottom: 1px solid #eee;
}

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
}

.filter-label {
  font-size: 28rpx;
  color: #333;
}

.filter-input {
  flex: 1;
  margin-left: 24rpx;
  padding: 12rpx 20rpx;
  font-size: 28rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  text-align: right;
}

.filter-tip {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.prompt-title {
  height: 50rpx;
  border-top: 1px solid #999;
  border-bottom: 1px solid #999;
  width: 100%;
}

.item {
  height: auto;
  padding: 8rpx 0;
}

.empty-tip {
  width: 100%;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}
